<script>
'use strict';


/* ===== v4.8.9 persistent self diagnostics ===== */
const HuNyangDiag=(()=>{
  const VERSION='4.8.37';
  const KEY='hunyang_diag_v1';
  const MAX_LINES=360;
  let storageOK=true;
  let db={schema:1,sessions:[],lines:[]};
  const sessionId=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7);

  function iso(){return new Date().toISOString()}
  function safeText(v){
    try{
      if(v instanceof Error)return `${v.name}: ${v.message}${v.stack?' | '+String(v.stack).replace(/\s+/g,' ').slice(0,700):''}`;
      if(typeof v==='string')return v;
      return JSON.stringify(v);
    }catch(_){return String(v)}
  }
  function load(){
    try{
      const raw=localStorage.getItem(KEY);
      if(raw){
        const parsed=JSON.parse(raw);
        if(parsed&&Array.isArray(parsed.lines)&&Array.isArray(parsed.sessions))db=parsed;
      }
    }catch(e){storageOK=false;db={schema:1,sessions:[],lines:[]}}
  }
  function persist(){
    if(!storageOK)return;
    try{localStorage.setItem(KEY,JSON.stringify(db))}catch(_){storageOK=false}
  }
  function trim(){
    if(db.lines.length>MAX_LINES)db.lines=db.lines.slice(-MAX_LINES);
    if(db.sessions.length>24)db.sessions=db.sessions.slice(-24);
  }
  function line(stage,detail=''){
    const row={t:iso(),sid:sessionId,v:VERSION,stage:String(stage),detail:safeText(detail||'')};
    db.lines.push(row);trim();persist();return row;
  }
  function finish(reason){
    const s=db.sessions.find(x=>x.id===sessionId);
    if(s&&!s.endedAt){s.endedAt=iso();s.endReason=reason||'unknown';persist()}
  }
  function exportText(){
    const hdr=[
      'Hu nyang Self Diagnostic Log',
      `Build: ${VERSION}`,
      `Exported: ${iso()}`,
      `Current session: ${sessionId}`,
      `Storage: ${storageOK?'OK':'FAILED'}`,
      `URL: ${location.href}`,
      `UserAgent: ${navigator.userAgent}`,
      `Viewport: ${innerWidth}x${innerHeight} DPR=${window.devicePixelRatio||1}`,
      '',
      '--- Sessions ---'
    ];
    const ses=db.sessions.map(s=>`${s.startedAt} | ${s.id} | v${s.version} | ${s.endedAt?'END '+s.endedAt+' '+(s.endReason||''):'UNFINISHED'} | ${s.ua||''}`);
    const body=['','--- Timeline ---',...db.lines.map(x=>`${x.t} | ${x.sid} | ${x.stage}${x.detail?' | '+x.detail:''}`)];
    return [...hdr,...ses,...body].join('\n');
  }
  function clear(){db={schema:1,sessions:[],lines:[]};persist();line('LOG_RESET','diagnostic log cleared by user')}

  load();
  const prev=db.sessions[db.sessions.length-1];
  if(prev&&!prev.endedAt){
    db.lines.push({t:iso(),sid:sessionId,v:VERSION,stage:'PREVIOUS_SESSION_UNFINISHED',detail:`${prev.id} v${prev.version} had no clean end marker`});
  }
  db.sessions.push({id:sessionId,version:VERSION,startedAt:iso(),endedAt:null,ua:navigator.userAgent,url:location.href});
  trim();persist();
  line('BOOT_SCRIPT_ENTER',`storage=${storageOK?'ok':'failed'}`);

  addEventListener('error',e=>line('JS_ERROR',`${e.message||'unknown'} @ ${e.filename||''}:${e.lineno||0}:${e.colno||0}`));
  addEventListener('unhandledrejection',e=>line('UNHANDLED_REJECTION',e.reason));
  document.addEventListener('visibilitychange',()=>line('VISIBILITY',document.visibilityState));
  addEventListener('pageshow',e=>line('PAGESHOW',`persisted=${!!e.persisted}`));
  addEventListener('pagehide',e=>{line('PAGEHIDE',`persisted=${!!e.persisted}`);finish('pagehide')});
  addEventListener('beforeunload',()=>{line('BEFOREUNLOAD');finish('beforeunload')});

  return {version:VERSION,sessionId,line,finish,exportText,clear,get storageOK(){return storageOK}};
})();
window.HuNyangDiag=HuNyangDiag;


const $ = (s, root=document) => root.querySelector(s);
const $$ = (s, root=document) => [...root.querySelectorAll(s)];

