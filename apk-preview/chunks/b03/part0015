const huPageNav={history:[],timer:0};
function showPage(id,navDirection='auto'){
  HuNyangDiag.line('PAGE_SHOW',id);
  const pages=$$('.page');
  const current=pages.find(p=>p.classList.contains('active'));
  const target=$('#'+id);
  if(!target)return;

  const appRoot=$('#app');
  if(appRoot){
    const isRpgLandscape=String(id).startsWith('rpg');
    appRoot.classList.toggle('huRpgLandscape',isRpgLandscape);
    try{ if(window.HuNyangAndroid&&HuNyangAndroid.setRpgLandscape) HuNyangAndroid.setRpgLandscape(isRpgLandscape); }catch(e){}
  }

  if(current?.id===id){
    window.scrollTo(0,0);
    if(id==='rpgReceptionPage'&&typeof rpgRenderReception==='function')rpgRenderReception();
    if(window.HuNyangTempSave)window.HuNyangTempSave(id);
    return;
  }

  if(!huPageNav.history.length&&current?.id)huPageNav.history=[current.id];

  let isBack=navDirection==='back';
  if(navDirection==='auto'){
    isBack=huPageNav.history.length>1&&huPageNav.history[huPageNav.history.length-2]===id;
  }

  if(isBack){
    if(huPageNav.history.length>1&&huPageNav.history[huPageNav.history.length-2]===id){
      huPageNav.history.pop();
    }else{
      const idx=huPageNav.history.lastIndexOf(id);
      if(idx>=0)huPageNav.history=huPageNav.history.slice(0,idx+1);
      else huPageNav.history.push(id);
    }
  }else{
    if(huPageNav.history[huPageNav.history.length-1]!==id)huPageNav.history.push(id);
  }

  pages.forEach(p=>{
    p.classList.remove('active','huSlideForward','huSlideBack');
  });
  target.classList.add('active',isBack?'huSlideBack':'huSlideForward');

  clearTimeout(huPageNav.timer);
  huPageNav.timer=setTimeout(()=>{
    target.classList.remove('huSlideForward','huSlideBack');
  },260);

  window.scrollTo(0,0);
  if(id==='rpgReceptionPage'&&typeof rpgRenderReception==='function')rpgRenderReception();
  if(window.HuNyangTempSave)window.HuNyangTempSave(id);
}
function toast(msg){
  const t=$('#toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(toast._t); toast._t=setTimeout(()=>t.classList.remove('show'),1700);
}
function charLen(v){ return [...v.trim()].length; }
function baseBoard(){ return Array.from({length:state.size*state.size},(_,i)=>i+1); }
function shuffled(a){
  const x=[...a];
  for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}
  return x;
}
function makeMiniGrid(btn,size){
  const host=$('.miniGrid',btn); host.innerHTML='';
  const count=size===3?9:9;
  for(let i=0;i<count;i++){const d=document.createElement('i');host.appendChild(d)}
}
$$('.sizeCard').forEach(b=>makeMiniGrid(b,+b.dataset.size));

function buildNickInputs(){
  const list=$('#nickList');
  const old=$$('input',list).map(x=>x.value);
  list.innerHTML='';
  state.players=[];
  for(let i=0;i<state.playerCount;i++){
    const row=document.createElement('div'); row.className='nickRow';
    const dot=document.createElement('div'); dot.className='catDot'; dot.textContent=catIcons[i];
    const input=document.createElement('input');
    input.maxLength=8; input.placeholder=`플레이어${i+1}`;
    input.value=(old[i]&&old[i].trim())?old[i]:defaults[i];
    input.setAttribute('aria-label',`플레이어 ${i+1} 닉네임`);
    row.append(dot,input); list.appendChild(row);
  }
}
buildNickInputs();

function selectPlayerCount(n){
  state.playerCount=n;
  $$('.segBtn').forEach(b=>b.classList.toggle('active',+b.dataset.count===n));
  buildNickInputs();
}
function selectSize(n){
  state.size=n;
  $$('.sizeCard').forEach(b=>b.classList.toggle('active',+b.dataset.size===n));
}
function validateConfig(){
  const inputs=$$('#nickList input');
  inputs.forEach(x=>x.classList.remove('errorInput'));
  const names=inputs.map(x=>x.value.trim());
  const bad=names.findIndex(x=>charLen(x)<2||charLen(x)>8);
  if(bad>=0){
    inputs[bad].classList.add('errorInput'); inputs[bad].focus();
    $('#configError').textContent='닉네임은 참가자마다 2~8글자로 입력해 주세요.';
    return false;
  }
  const dup=names.findIndex((x,i)=>names.indexOf(x)!==i);
  if(dup>=0){
    inputs[dup].classList.add('errorInput'); inputs[dup].focus();
    $('#configError').textContent='닉네임은 서로 다르게 입력해 주세요.';
    return false;
  }
  $('#configError').textContent='';
  state.players=names;
  return true;
}
function openArrange(){
  if(!validateConfig()) return;
  state.boards=state.players.map(()=>baseBoard());
  state.selectedPlayer=0; state.firstCell=null;
  renderArrange();
  showPage('arrangePage');
}
function renderPlayerTabs(){
  const host=$('#playerTabs'); host.innerHTML='';
  state.players.forEach((name,i)=>{
    const b=document.createElement('button'); b.className='playerTab'+(i===state.selectedPlayer?' active':'');
    b.innerHTML=`<b>${i+1}P</b><small></small>`; $('small',b).textContent=name;
    b.onclick=()=>{state.selectedPlayer=i;state.firstCell=null;renderArrange()};
    host.appendChild(b);
  });
}
function renderArrange(){
  renderPlayerTabs();
  const board=$('#setupBoard'); board.innerHTML='';
  board.style.gridTemplateColumns=`repeat(${state.size},1fr)`;
  state.boards[state.selectedPlayer].forEach((num,idx)=>{
    const b=document.createElement('button'); b.className='boardCell'+(state.firstCell===idx?' selected':'');
    b.textContent=num;
    b.onclick=()=>handleCellSwap(idx);
    board.appendChild(b);
  });
}
function handleCellSwap(idx){
  if(state.firstCell===null){state.firstCell=idx;renderArrange();return}
  if(state.firstCell===idx){state.firstCell=null;renderArrange();return}
  const a=state.boards[state.selectedPlayer];
  [a[state.firstCell],a[idx]]=[a[idx],a[state.firstCell]];
  state.firstCell=null; renderArrange();
}
function resetCurrent(){
  state.boards[state.selectedPlayer]=baseBoard(); state.firstCell=null; renderArrange();
}
function shuffleCurrent(){
  state.boards[state.selectedPlayer]=shuffled(baseBoard()); state.firstCell=null; renderArrange();
}

function countLines(p){
  const m=state.marks[p]; if(!m) return 0;
  const n=state.size; let lines=0;
  for(let r=0;r<n;r++){
    let ok=true;for(let c=0;c<n;c++) if(!m[r*n+c]){ok=false;break} if(ok)lines++;
  }
  for(let c=0;c<n;c++){
    let ok=true;for(let r=0;r<n;r++) if(!m[r*n+c]){ok=false;break} if(ok)lines++;
  }
  let d1=true,d2=true;
  for(let i=0;i<n;i++){if(!m[i*n+i])d1=false;if(!m[i*n+(n-1-i)])d2=false}
  if(d1)lines++;if(d2)lines++;
  return lines;
}
function renderGameBoards(){
  const host=$('#gameBoards'); host.innerHTML='';
  host.classList.toggle('multi',state.players.length>1);
  const nextCounts=[];
  state.players.forEach((name,p)=>{
    const lines=countLines(p);
    const prev=state.prevLineCounts?.[p] ?? 0;
    const changed=lines!==prev;

    const card=document.createElement('div'); card.className=`playerBoardCard p${p+1}`;
    const head=document.createElement('div'); head.className='playerBoardHead';
    const nm=document.createElement('b'); nm.textContent=`${p+1}P  ${name}`;
    const bc=document.createElement('span'); bc.className='bingoCount';
    bc.innerHTML=`<span class="countNum${changed?' pop':''}">${lines}</span> / 3 BINGO`;
    head.append(nm,bc); card.appendChild(head);

    const board=document.createElement('div'); board.className='gameBoard';
    board.style.gridTemplateColumns=`repeat(${state.size},1fr)`;
    state.boards[p].forEach((num,i)=>{
      const c=document.createElement('div'); c.className='gameCell'+(state.marks[p]?.[i]?' marked':'');
      c.innerHTML=`<span>${num}</span>`;
      board.appendChild(c);
    });
    card.appendChild(board); host.appendChild(card);
    nextCounts.push(lines);
  });
  state.prevLineCounts=nextCounts;
}
function renderHistory(){
  const host=$('#historyChips'); host.innerHTML='';
  if(!state.drawn.length){
    const s=document.createElement('span');s.className='muted';s.style.fontSize='11px';s.textContent='아직 없음';host.appendChild(s);return;
  }
  state.drawn.forEach((n,i)=>{
    const c=document.createElement('div');c.className='numChip'+(i===state.drawn.length-1?' latest':'');c.textContent=n;host.appendChild(c);
  });
  host.scrollLeft=host.scrollWidth;
}
function resetProgress(){
  const p=$('#progressBar');
  p.style.transition='none';
  p.style.width='100%';

  // 레이아웃을 한 번 확정한 뒤 5초 동안 100% -> 0%로 연속 감소
  void p.offsetWidth;

  requestAnimationFrame(()=>{
    p.style.transition='width 5s linear';
    p.style.width='0%';
  });
}
function startGame(){
  HuNyangDiag.line('GAME_START',`players=${state.players.length},size=${state.size}`);
  clearInterval(state.timer);
  state.drawPool=shuffled(baseBoard());
  state.drawn=[];
  state.marks=state.players.map(()=>Array(state.size*state.size).fill(false));
  state.countdown=5;
  state.running=true;
  state.awaitingDraw=false;
  state.currentNumber=null;
  state.prevLineCounts=Array(state.players.length).fill(0);

  renderGameBoards();
  renderHistory();
  showPage('gamePage');

  revealNextNumber();
  state.timer=setInterval(tick,1000);
}
function revealNextNumber(){
  if(!state.running)return;
  if(!state.drawPool.length){
    state.running=false;
    clearInterval(state.timer);
    $('#countText').textContent='모든 숫자가 추첨되었습니다.';
    return;
  }

  state.currentNumber=state.drawPool.shift();
  $('#drawNum').textContent=state.currentNumber;
  $('#drawNum').classList.remove('drawReady');

  state.countdown=5;
  $('#countText').textContent='다음 숫자까지 5초';
  resetProgress();
}

function commitCurrentNumber(){
  if(state.currentNumber===null)return;

  const num=state.currentNumber;
  state.drawn.push(num);

  state.players.forEach((_,p)=>{
    const idx=state.boards[p].indexOf(num);
    if(idx>=0)state.marks[p][idx]=true;
  });

  renderGameBoards();
  renderHistory();

  const winners=state.players
    .map((name,i)=>({name,i,lines:countLines(i)}))
    .filter(x=>x.lines>=3);

  if(winners.length){
    finishGame(winners);
    return true;
  }
  return false;
}

function tick(){
  if(!state.running || state.awaitingDraw)return;

  state.countdown--;
  const remain=Math.max(0,state.countdown);
  $('#countText').textContent=`다음 숫자까지 ${remain}초`;

  if(remain===0){
    state.awaitingDraw=true;

    // 0초와 게이지 0%가 실제로 한 프레임 표시된 뒤 체크/다음 숫자로 진행
    requestAnimationFrame(()=>{
      requestAnimationFrame(()=>{
        if(!state.running)return;

        const p=$('#progressBar');
        p.style.transition='none';
        p.style.width='0%';

        setTimeout(()=>{
          if(!state.running)return;

          const won=commitCurrentNumber();
          if(won)return;

          state.currentNumber=null;
          revealNextNumber();
          state.awaitingDraw=false;
        },120);
      });
    });
  }
}
