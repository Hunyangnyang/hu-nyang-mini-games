/* 페이지 전환은 showPage()가 방향 클래스를 잠깐 붙여 사용한다. */
.page{
  animation:none!important;
}
.page.huSlideForward{
  animation:huPageSlideForward .22s cubic-bezier(.22,.72,.28,1) both!important;
}
.page.huSlideBack{
  animation:huPageSlideBack .22s cubic-bezier(.22,.72,.28,1) both!important;
}
@keyframes huPageSlideForward{
  from{opacity:.72;transform:translateX(38px)}
  to{opacity:1;transform:translateX(0)}
