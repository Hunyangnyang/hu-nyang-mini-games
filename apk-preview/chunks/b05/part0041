function ensureRelations(){rpgState.guildNpcRelations=rpgState.guildNpcRelations||{};for(const k of ['rubia','kain'])rpgState.guildNpcRelations[k]={affinity:0,meetings:0,lastDay:-1,...(rpgState.guildNpcRelations[k]||{})};return rpgState.guildNpcRelations}
function worldDay(){return Math.floor((Number(rpgState.worldTurn)||0)/16)+1}
function tier(v){return v<0?'neg':v>0?'pos':'zero'}
function relationColor(v){v=Math.max(-10,Math.min(10,Number(v)||0));const stops=[[-10,[59,130,246]],[-5,[45,212,191]],[0,[34,197,94]],[5,[250,204,21]],[10,[239,68,68]]];for(let i=0;i<stops.length-1;i++){const [a,ca]=stops[i],[b,cb]=stops[i+1];if(v<=b){const t=(v-a)/(b-a);return `rgb(${ca.map((x,j)=>Math.round(x+(cb[j]-x)*t)).join(',')})`}}return 'rgb(239,68,68)'}
function updateRelationGauge(v,burst=false){const cl=Math.max(-10,Math.min(10,Number(v)||0)),pct=(cl+10)*5,color=relationColor(cl),fill=$v('#rpgRelationFill'),heart=$v('#rpgRelationHeart');if(fill){fill.style.width=pct+'%';fill.style.backgroundColor=color}if(heart){heart.style.color=color;heart.style.animationDuration=(1.25-Math.max(0,cl)*.02)+'s';if(burst){heart.classList.remove('burst');void heart.offsetWidth;heart.classList.add('burst')}}}
