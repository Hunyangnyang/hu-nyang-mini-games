let npcTimer=0,currentNpc=null;
function startNpcTalk(k){const rel=ensureRelations()[k],d=dialogueData[k];if(rel.lastDay===worldDay())return;currentNpc=k;$v('#rpgGuildNpcSelect').style.display='none';$v('#rpgGuildNpcTalk').style.display='';$v('#rpgGuildNpcName').textContent=`${d.name}(${d.job})`;$v('#rpgGuildNpcArt').src=npcArtFor(k,rel.affinity);$v('#rpgGuildNpcChoices').innerHTML='';updateRelationGauge(rel.affinity,false);let line;if(rel.meetings===0)line=d.first;else if(rel.meetings>=10)line=pick(d.long[tier(rel.affinity)]);else line=d.greet[tier(rel.affinity)];$v('#rpgGuildNpcSpeech').textContent=line;clearTimeout(npcTimer);npcTimer=setTimeout(()=>showNpcQuestion(k),5000)}
function showNpcQuestion(k){const rel=ensureRelations()[k],d=dialogueData[k],q=pick(d.questions);$v('#rpgGuildNpcSpeech').textContent=q[0];const host=$v('#rpgGuildNpcChoices');host.innerHTML='';shuffle(q[1]).forEach(([text,delta])=>{const b=document.createElement('button');b.type='button';b.textContent=text;b.addEventListener('click',()=>finishNpcTalk(k,delta));host.appendChild(b)})}
function finishNpcTalk(k,delta){const rel=ensureRelations()[k],d=dialogueData[k];rel.affinity=Number(rel.affinity||0)+Number(delta||0);rel.meetings=Number(rel.meetings||0)+1;rel.lastDay=worldDay();$v('#rpgGuildNpcArt').src=npcArtFor(k,rel.affinity);updateRelationGauge(rel.affinity,true);$v('#rpgGuildNpcChoices').innerHTML='';const pool=rel.meetings>=11?d.long[tier(rel.affinity)]:d.reply[tier(rel.affinity)];$v('#rpgGuildNpcSpeech').textContent=pick(pool);rpgSaveActiveSlot(null,'guild_npc_talk');setTimeout(updateNpcSelect,100)}
$v('#rpgGuildAdventurerTalkBtn')?.addEventListener('click',openNpcSelect);$v('#rpgGuildNpcClose')?.addEventListener('click',()=>{clearTimeout(npcTimer);setAppModal('rpgGuildNpcModal',false)});$v('#rpgGuildNpcBackToSelect')?.addEventListener('click',()=>{clearTimeout(npcTimer);$v('#rpgGuildNpcSelect').style.display='';$v('#rpgGuildNpcTalk').style.display='none';updateNpcSelect()});$$v('[data-guild-npc]').forEach(b=>b.addEventListener('click',()=>startNpcTalk(b.dataset.guildNpc)));
const renderGuildOriginal=rpgRenderGuild;rpgRenderGuild=function(){renderGuildOriginal();ensureRelations();const part=rpgPartFromTurn(rpgState.worldTurn||0),art=$v('#rpgGuildInteriorArt');if(art)art.src=(part.key==='morning'||part.key==='noon')?V38_ASSETS.guildBright:V38_ASSETS.guildDark};

window.V38_ASSETS=V38_ASSETS;
window.V38_dialogueData=dialogueData;
window.V38_ensureRelations=ensureRelations;
window.V38_updateNpcSelect=updateNpcSelect;
window.V38_startNpcTalk=startNpcTalk;
window.V38_materialDefs=materialDefs;
