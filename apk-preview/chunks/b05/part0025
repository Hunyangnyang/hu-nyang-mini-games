const mascotLines=[
  '어서 오라냥~! 오늘도 놀러 왔냥? ♡',
  '게임 한 판 하고 갈 거냥? 준비됐냥~?',
  '후냥이랑 승부하자냥! 봐주기 없다냥♪',
  '오늘의 승자는 누구일까냥? 두근두근이다냥!',
  '빙고 한 판 어때냥? 먼저 3줄 만드는 거다냥~!'
];

let speechTimer=null;
let speechUnlockTimer=null;
let speechLocked=false;
let lastSpeechIndex=-1;

function showMascotSpeech(){
  const bubble=$('#mascotSpeech');
  const text=$('#speechText');
  if(!bubble||!text)return false;

  /* 이미 떠 있거나 사라지는 중이면 새 대사 출력 금지 */
  if(speechLocked)return false;

  speechLocked=true;

  let index=Math.floor(Math.random()*mascotLines.length);

  /* 같은 대사가 바로 연속으로 나오지 않게 처리 */
  if(mascotLines.length>1 && index===lastSpeechIndex){
    index=(index+1+Math.floor(Math.random()*(mascotLines.length-1)))%mascotLines.length;
  }
  lastSpeechIndex=index;

  text.textContent=mascotLines[index];

  bubble.classList.remove('show');
  void bubble.offsetWidth;
  bubble.classList.add('show');

  clearTimeout(speechTimer);
  clearTimeout(speechUnlockTimer);

  /* 정확히 5초 동안 유지 */
  speechTimer=setTimeout(()=>{
    bubble.classList.remove('show');

    /* 페이드아웃이 끝난 뒤에만 다음 클릭을 허용 */
    speechUnlockTimer=setTimeout(()=>{
      speechLocked=false;
    },320);
  },5000);

  return true;
}

const splashMascot=$('.splashMascot');
if(splashMascot){
  let clickMotionTimer=null;
  let resetPoseTimer=null;

  splashMascot.addEventListener('click',()=>{
    showMascotSpeech();

    /* 연속 클릭 시 기존 클릭/복귀 타이머를 취소하고 모션을 즉시 처음부터 재생 */
    clearTimeout(clickMotionTimer);
    clearTimeout(resetPoseTimer);

    splashMascot.classList.remove('is-clicking','is-resetting');

    /* 애니메이션 재시작을 보장하기 위한 강제 reflow */
    void splashMascot.offsetWidth;

    splashMascot.classList.add('is-clicking');

    clickMotionTimer=setTimeout(()=>{
      splashMascot.classList.remove('is-clicking');
      splashMascot.classList.add('is-resetting');

      resetPoseTimer=setTimeout(()=>{
        splashMascot.classList.remove('is-resetting');

        /* idle 애니메이션도 항상 같은 초기 자세에서 다시 시작 */
        void splashMascot.offsetWidth;
      },110);
    },590);

    /* 하트는 클릭할 때마다 별도로 생성 */
    const heart=document.createElement('span');
    heart.className='heartBurst';
    heart.textContent='❤';

    const side=Math.floor(Math.random()*4);
    const edgePadding=6+Math.random()*6;
    let xPct=50, yPct=50;
    let dx1=0,dy1=0,dx2=0,dy2=0;

    if(side===0){ /* top */
      xPct=18+Math.random()*64;
      yPct=edgePadding;
      dx1=(Math.random()*22-11);
      dy1=-(15+Math.random()*16);
      dx2=(Math.random()*56-28);
      dy2=-(55+Math.random()*42);
    }else if(side===1){ /* right */
      xPct=100-edgePadding;
      yPct=18+Math.random()*64;
      dx1=18+Math.random()*15;
      dy1=(Math.random()*22-11);
      dx2=62+Math.random()*42;
      dy2=-(18+Math.random()*45);
    }else if(side===2){ /* bottom */
      xPct=18+Math.random()*64;
      yPct=100-edgePadding;
      dx1=(Math.random()*22-11);
      dy1=15+Math.random()*13;
      dx2=(Math.random()*52-26);
      dy2=45+Math.random()*32;
    }else{ /* left */
      xPct=edgePadding;
      yPct=18+Math.random()*64;
      dx1=-(18+Math.random()*15);
      dy1=(Math.random()*22-11);
      dx2=-(62+Math.random()*42);
      dy2=-(18+Math.random()*45);
    }

    heart.style.left=xPct+'%';
    heart.style.top=yPct+'%';
    heart.style.setProperty('--dx1',dx1+'px');
    heart.style.setProperty('--dy1',dy1+'px');
    heart.style.setProperty('--dx2',dx2+'px');
    heart.style.setProperty('--dy2',dy2+'px');
    heart.style.setProperty('--rot0',(Math.random()*16-8)+'deg');
    heart.style.setProperty('--rot1',(Math.random()*30-15)+'deg');
    heart.style.setProperty('--rot2',(Math.random()*80-40)+'deg');

    splashMascot.appendChild(heart);
    setTimeout(()=>heart.remove(),900);
  });
}





