function randomAction(){return Math.random()<0.5?'attack':'defend'}
function randomRoll(){return 1+Math.floor(Math.random()*20)}
function startColSelectPhase(){
  const b=colState.currentBattle;if(!b)return;
  b.stage='select';
  $('#colTimerSub').textContent='선택 제한 시간';
  $('#colBattleNotice').textContent=`${b.round}라운드 · 공격/방어를 선택하고 주사위를 굴려라냥.`;
  $('#colAnimPanel').className='animPanel battleLogBar';
  $('#colAnimPanel').textContent=`${b.round}라운드 진행 중 · 상대 선택은 비공개`;
  const side=battleUserSide();
