function applyColUserAction(action){
  const b=colState.currentBattle;if(!b||b.stage!=='select')return;
  const side=battleUserSide(); if(!side)return;
  const choice=side==='left'?b.leftChoice:b.rightChoice;
  if(choice.roll||b.diceRolling){
    toast('주사위를 굴린 뒤에는 공격/방어를 바꿀 수 없다냥 🐾');
    return;
  }
  choice.action=action;
  renderColControls();
}
function rollColUserDice(){
  const b=colState.currentBattle;if(!b||b.stage!=='select')return;
  const side=battleUserSide(); if(!side)return;
  const choice=side==='left'?b.leftChoice:b.rightChoice;
  if(!choice.action){toast('먼저 공격 또는 방어를 골라라냥 🐾');return}
  if(choice.roll||b.diceRolling){toast('이번 라운드 주사위는 이미 굴렸다냥.');return}

  // Roll commits the action immediately. From this exact moment attack/defence is locked.
  choice.roll=randomRoll();
  b.diceRolling=true;
  renderColControls();

  setTimeout(()=>{
    if(!colState.currentBattle||colState.currentBattle!==b)return;
    b.diceRolling=false;
    renderColControls();
  },360);
}
function calcColRound(){
  const b=colState.currentBattle; const L=b.leftChoice,R=b.rightChoice;
