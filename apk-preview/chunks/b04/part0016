    $('#colTimer').textContent='AI';
    $('#colTimerSub').textContent='자동 전투';
    colState.flowTimer=setTimeout(()=>revealColRound(),1200);
    return;
  }
  const aiSide=side==='left'?'right':'left';
  if(aiSide==='left')b.leftChoice={action:randomAction(),roll:randomRoll()}; else b.rightChoice={action:randomAction(),roll:randomRoll()};
  renderColControls();
  let remain=10; $('#colTimer').textContent=remain;
  colState.tickTimer=setInterval(()=>{
    remain--; $('#colTimer').textContent=Math.max(0,remain);
    if(remain<=0){
      clearColTimers();
      const choice=side==='left'?b.leftChoice:b.rightChoice;
