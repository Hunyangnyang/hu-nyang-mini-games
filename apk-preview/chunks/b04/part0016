function colBattleDisplayName(p){return p.isUser?'플레이어':p.job.name}
function colActionLabel(choice){
  if(!choice||!choice.action)return '❔ ?';
  return `${choice.action==='attack'?'⚔':'🛡'} ${choice.roll}`;
}
function buildColBattleHistoryText(b,result){
  const left=colBattleDisplayName(b.left), right=colBattleDisplayName(b.right);
  const base=`${left} ${colActionLabel(b.leftChoice)} / ${right} ${colActionLabel(b.rightChoice)}`;
  const L=b.leftChoice.action,R=b.rightChoice.action;
  if(L==='defend'&&R==='defend')return `${base} → 서로 방어 · 피해 없음`;
  if(L==='attack'&&R==='attack')return `${base} → ${left} ${result.dmgLeft} 피해 · ${right} ${result.dmgRight} 피해`;
  if(L==='attack'&&R==='defend')return result.dmgRight>0?`${base} → ${right} ${result.dmgRight} 피해`:`${base} → ${right} 방어 성공 · 피해 없음`;
  if(L==='defend'&&R==='attack')return result.dmgLeft>0?`${base} → ${left} ${result.dmgLeft} 피해`:`${base} → ${left} 방어 성공 · 피해 없음`;
  return `${base} → 공방 종료`;
}
