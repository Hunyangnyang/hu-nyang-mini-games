function rpgRest(mode){const members=1+(rpgState.ai?1:0),cost=members*2;if((rpgState.gold||0)<cost){toast('숙박비가 부족하다냥 🐾');return}const turnInDay=(rpgState.worldTurn||0)%16,turnsToMorning=(16-turnInDay)%16||16;const pd=rpgDerived(rpgState.job,rpgState.stats,rpgState.skills,rpgState.equipment);rpgEnsureEquipment(rpgState.ai);const ad=rpgState.ai?rpgDerived(rpgState.ai.job,rpgState.ai.stats,rpgState.ai.skills,rpgState.ai.equipment):null;if(rpgState.currentHp==null)rpgState.currentHp=pd.maxHp;if(rpgState.currentMp==null)rpgState.currentMp=pd.maxMp;if(rpgState.ai){if(rpgState.ai.currentHp==null)rpgState.ai.currentHp=ad.maxHp;if(rpgState.ai.currentMp==null)rpgState.ai.currentMp=ad.maxMp}const before={pHp:rpgState.currentHp,pMp:rpgState.currentMp,aHp:rpgState.ai?.currentHp??null,aMp:rpgState.ai?.currentMp??null,gold:rpgState.gold};let turns=turnsToMorning;const apply=(t)=>{const ratio=.05*t;rpgState.currentHp=Math.min(pd.maxHp,rpgState.currentHp+pd.maxHp*ratio);rpgState.currentMp=Math.min(pd.maxMp,rpgState.currentMp+pd.maxMp*ratio);if(rpgState.ai){rpgState.ai.currentHp=Math.min(ad.maxHp,rpgState.ai.currentHp+ad.maxHp*ratio);rpgState.ai.currentMp=Math.min(ad.maxMp,rpgState.ai.currentMp+ad.maxMp*ratio)}};apply(turnsToMorning);if(mode==='full'){const missing=Math.max((pd.maxHp-rpgState.currentHp)/pd.maxHp,(pd.maxMp-rpgState.currentMp)/pd.maxMp,rpgState.ai?Math.max((ad.maxHp-rpgState.ai.currentHp)/ad.maxHp,(ad.maxMp-rpgState.ai.currentMp)/ad.maxMp):0);const extra=Math.ceil(Math.max(0,missing)/.05);if(extra>0){apply(extra);turns+=extra}}const fp=rpgState.field?.party?.find(x=>x.id==='player'),fa=rpgState.field?.party?.find(x=>x.id==='ai');if(fp){fp.hp=rpgState.currentHp;fp.mp=rpgState.currentMp;fp.dead=fp.hp<=0}if(fa&&rpgState.ai){fa.hp=rpgState.ai.currentHp;fa.mp=rpgState.ai.currentMp;fa.dead=fa.hp<=0}rpgState.gold-=cost;rpgAdvanceTurns(turns,mode==='full'?'완벽 휴식':'아침까지 숙박');HuNyangDiag.line('RPG_INN_REST',`${mode}|turns=${turns}|cost=${cost}G|player=${Math.round(before.pHp)}/