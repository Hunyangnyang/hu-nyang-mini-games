  if(!Object.prototype.hasOwnProperty.call(target,'statPoints'))target.statPoints=rpgStatPointsEarnedToLevel(lv);
  if(!Object.prototype.hasOwnProperty.call(target,'skillPoints'))target.skillPoints=lv;
  if(!target.skills||typeof target.skills!=='object')target.skills=rpgNewSkills();
  rpgSkillDefs.forEach(x=>{if(!Number.isFinite(target.skills[x.id]))target.skills[x.id]=0;target.skills[x.id]=Math.max(0,Math.min(x.max,Math.floor(target.skills[x.id]))) });
